# Scripts editados no Windows e executados no Rocky Linux precisam terminar em LF.
# Com CRLF o kernel lê o shebang como "/usr/bin/env bash\r" e a execução falha
# com "bad interpreter: no such file or directory".
*.sh text eol=lf

# Arquivos de configuração copiados para a VM seguem a mesma regra.
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf

# Documentação
*.md text
